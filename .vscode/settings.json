{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,

  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.diagnosticMode": "workspace",
  "python.analysis.indexing": true,
  "python.analysis.exclude": ["**/migrations/**", "**/.venv/**"],

  "black-formatter.interpreter": ["${workspaceFolder}/.venv/bin/python"],
  "pylint.interpreter": ["${workspaceFolder}/.venv/bin/python"],
  "pylint.args": ["--rcfile=${workspaceFolder}/pyproject.toml"],
  "pylint.cwd": "${workspaceFolder}",

  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.envFile": "${workspaceFolder}/.env",

  "editor.rulers": [100],
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true,
    "editor.tabSize": 4
  },

  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/staticfiles": true
  }
}
